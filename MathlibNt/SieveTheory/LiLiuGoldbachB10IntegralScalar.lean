private lemma b10H_endpoint : 8*(b10H (15/116)-b10H 0) ≤ (540996/100000 : ℝ) := by
  norm_num [b10H]

private def b10U (x : ℝ) : ℝ := 1 - (6/11)/(3/4-x)
private def b10F (x : ℝ) : ℝ :=
  Real.log ((1+(x+1/4))/(1-(x+1/4)))/(9/44-x)

private lemma b10U_maps {x : ℝ} (hx : x ∈ Icc (0 : ℝ) (15/116)) :
    b10U x ∈ Icc (4/33 : ℝ) (3/11) := by
  have hp : 0 < 3/4-x := by linarith [hx.2]
  dsimp [b10U]
  constructor
  · have h : (6/11 : ℝ)/(3/4-x) ≤ 29/33 := (div_le_iff₀ hp).2 (by linarith [hx.2])
    linarith
  · have h : (8/11 : ℝ) ≤ (6/11)/(3/4-x) := (le_div_iff₀ hp).2 (by linarith [hx.1])
    linarith

private lemma b10F_continuous : ContinuousOn b10F (Icc (0 : ℝ) (15/116)) := by
  have hd : ∀ x ∈ Icc (0 : ℝ) (15/116), 1-(x+1/4) ≠ 0 := by
    intro x hx; linarith [hx.2]
  apply ContinuousOn.div
    (((continuousOn_const.add (continuousOn_id.add continuousOn_const)).div
      (continuousOn_const.sub (continuousOn_id.add continuousOn_const)) hd).log ?_)
    (continuousOn_const.sub continuousOn_id) ?_
  · intro x hx
    change (1+(x+1/4))/(1-(x+1/4)) ≠ 0
    exact div_ne_zero (by linarith [hx.1]) (hd x hx)
  · intro x hx
    change 9/44-x ≠ 0
    linarith [hx.2]

private lemma b10_change_integral :
    goldbachB10I10 = ∫ x in (0 : ℝ)..(15/116), b10F x := by
  let f : ℝ → ℝ := fun u => Real.log ((1-u-3/11)/(3/11))/(u*(1-u))
  have hd : ∀ x ∈ uIcc (0 : ℝ) (15/116),
      HasDerivAt b10U (-(6/11)/(3/4-x)^2) x := by
    intro x hx
    rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 15/116)] at hx
    have hp : 3/4-x ≠ 0 := by linarith [hx.2]
    change HasDerivAt (fun x : ℝ => 1-(6/11)/(3/4-x)) _ x
    convert! ((((hasDerivAt_id x).const_sub (3/4)).inv hp).const_mul (6/11)).const_sub 1 using 1
    norm_num [id, one_div, div_eq_mul_inv]
  have hj : ContinuousOn (fun x : ℝ => -(6/11)/(3/4-x)^2) (uIcc (0 : ℝ) (15/116)) := by
    apply continuousOn_const.div ((continuousOn_const.sub continuousOn_id).pow 2)
    intro x hx
    rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 15/116)] at hx
    exact pow_ne_zero 2 (by change 3/4-x ≠ 0; linarith [hx.2])
  have hf : ContinuousOn f (Icc (4/33 : ℝ) (3/11)) := by
    apply ContinuousOn.div
      ((((continuousOn_const.sub continuousOn_id).sub continuousOn_const).div_const (3/11)).log ?_)
      (continuousOn_id.mul (continuousOn_const.sub continuousOn_id)) ?_
    · intro u hu
      change (1-u-3/11)/(3/11) ≠ 0
      exact div_ne_zero (by linarith [hu.2]) (by norm_num)
    · intro u hu
      change u*(1-u) ≠ 0
      exact mul_ne_zero (by linarith [hu.1]) (by linarith [hu.2])
  have hc : ContinuousOn f (b10U '' uIcc (0 : ℝ) (15/116)) := by
    apply hf.mono
    rintro u ⟨x, hx, rfl⟩
    rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 15/116)] at hx
    exact b10U_maps hx
  have h := intervalIntegral.integral_comp_mul_deriv' hd hj hc
  have he : (∫ x in (0 : ℝ)..(15/116), f (b10U x) * (-(6/11)/(3/4-x)^2)) =
      ∫ x in (0 : ℝ)..(15/116), -b10F x := by
    apply intervalIntegral.integral_congr
    intro x hx
    rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 15/116)] at hx
    have hp : 3/4-x ≠ 0 := by linarith [hx.2]
    have hq : 9/44-x ≠ 0 := by linarith [hx.2]
    have hm : 1-(x+1/4) ≠ 0 := by linarith [hx.2]
    have h3 : 3-4*x ≠ 0 := by linarith [hx.2]
    have h4 : 4-(4*x+1) ≠ 0 := by linarith [hx.2]
    have h9 : 9-44*x ≠ 0 := by linarith [hx.2]
    have h3r : 3-x*4 ≠ 0 := by linarith [hx.2]
    have h9r : 9-x*44 ≠ 0 := by linarith [hx.2]
    have heq : (1-b10U x-3/11)/(3/11) = (1+(x+1/4))/(1-(x+1/4)) := by
      dsimp [b10U]
      field_simp [hp, hm, h3, h4, h3r]
      ring
    dsimp only [f, b10F]
    rw [heq]
    dsimp [b10U]
    generalize Real.log ((1 + (x + 1 / 4)) / (1 - (x + 1 / 4))) = l
    field_simp [hp, hq, hm, h3, h4, h9, h3r, h9r]
    ring_nf
    field_simp [h9r]
    ring
  change (∫ x in (0 : ℝ)..(15/116), f (b10U x) * (-(6/11)/(3/4-x)^2)) = _ at h
  rw [he, intervalIntegral.integral_neg] at h
  norm_num [b10U] at h
  rw [goldbachB10I10_eq_singleIntegral]
  change (∫ u in (4/33 : ℝ)..(3/11), f u) = _
  rw [intervalIntegral.integral_symm (a := (4/33 : ℝ)) (b := 3/11)] at h
  exact neg_inj.mp h.symm

/-- Unconditional purely analytic bound for the unchanged production integral I10. -/
theorem goldbachB10I10_eight_mul_le_540996 :
    8 * goldbachB10I10 ≤ (540996/100000 : ℝ) := by
  have hpoly : Continuous (fun x : ℝ => b10L x*b10G x) := by
    unfold b10L b10G
    fun_prop
  have hpi := hpoly.intervalIntegrable (μ := volume) (a := (0 : ℝ)) (b := 15/116)
  have hfi : IntervalIntegrable b10F volume 0 (15/116) := by
    apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le (by norm_num : (0 : ℝ) ≤ 15/116)]
    exact b10F_continuous
  have hmono := intervalIntegral.integral_mono_on
    (by norm_num : (0 : ℝ) ≤ 15/116) hfi hpi (fun x hx => by
      have hp : 0 ≤ 1/(9/44-x) := div_nonneg (by norm_num) (by linarith [hx.2])
      calc
        b10F x = Real.log ((1+(x+1/4))/(1-(x+1/4))) * (1/(9/44-x)) := by
          dsimp [b10F]; ring
        _ ≤ b10L x * (1/(9/44-x)) := mul_le_mul_of_nonneg_right (b10L_bound hx) hp
        _ ≤ b10L x * b10G x := mul_le_mul_of_nonneg_left (b10G_bound hx) (b10L_nonneg hx.1))
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun x (_hx : x ∈ uIcc (0 : ℝ) (15/116)) => b10H_deriv x) hpi
  rw [hftc, ← b10_change_integral] at hmono
  exact (mul_le_mul_of_nonneg_left hmono (by norm_num : (0 : ℝ) ≤ 8)).trans b10H_endpoint

