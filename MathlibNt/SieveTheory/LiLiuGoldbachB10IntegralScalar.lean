private lemma b10L_bound {x : ℝ} (hx : x ∈ Icc (0 : ℝ) (15/116)) :
    Real.log ((1+(x+1/4))/(1-(x+1/4))) ≤ b10L x := by
  have hy : 0 ≤ x+1/4 := by linarith [hx.1]
  have hyu : x+1/4 ≤ (2/5 : ℝ) := by linarith [hx.2]
  have hy2 : (x+1/4)^2 ≤ (4/25 : ℝ) := by
    nlinarith [mul_nonneg hy (sub_nonneg.mpr hyu)]
  have hp : 0 < 1-(x+1/4)^2 := by linarith
  have hb : (x+1/4)^25/(1-(x+1/4)^2) ≤ 25/21*(x+1/4)^25 := by
    apply (div_le_iff₀ hp).2
    nlinarith [mul_nonneg (pow_nonneg hy 25) (show 0 ≤ 4/25-(x+1/4)^2 by linarith)]
  have h := Real.log_div_le_sum_range_add hy (by linarith) 12
  dsimp [b10L]
  linarith

private lemma b10G_bound {x : ℝ} (hx : x ∈ Icc (0 : ℝ) (15/116)) :
    1/(9/44-x) ≤ b10G x := by
  have hp : 0 < 9/44-x := by linarith [hx.2]
  apply (div_le_iff₀ hp).2
  have hi : b10G x*(9/44-x)-1 = (44/9*x)^48*(55- (1276/3)*x)/32 := by
    dsimp [b10G]
    norm_num [Finset.sum_range_succ]
    ring
  have hn : 0 ≤ (44/9*x)^48*(55-(1276/3)*x)/32 := by
    apply div_nonneg (mul_nonneg (pow_nonneg (mul_nonneg (by norm_num) hx.1) _) (by linarith [hx.2])) (by norm_num)
  linarith

private lemma b10L_nonneg {x : ℝ} (hx : 0 ≤ x) : 0 ≤ b10L x := by
  dsimp [b10L]
  positivity

