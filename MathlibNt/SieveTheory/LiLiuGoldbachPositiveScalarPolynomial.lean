theorem goldbachPositiveScalarH_eq (z : ℝ) :
    goldbachPositiveScalarH z = (∑ k ∈ range 32, z^k) -
      (1/3 : ℝ)*(∑ k ∈ range 32, (z/3)^k) := by
  simp [goldbachPositiveScalarH, goldbachPositiveScalarHCoeffs,
    S3Polynomial.eval_add, S3Polynomial.eval_scale, S3Polynomial.eval_geom,
    div_eq_mul_inv, mul_comm, sub_eq_add_neg]

theorem goldbachPositiveScalarP_nonneg {z : ℝ} (hz : 0 ≤ z) :
    0 ≤ goldbachPositiveScalarP z := by
  rw [goldbachPositiveScalarP_eq]
  unfold goldbachS3_innerPolynomial
  positivity

