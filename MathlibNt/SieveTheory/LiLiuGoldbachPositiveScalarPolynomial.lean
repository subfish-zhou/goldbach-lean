      S3Polynomial.mul s3pCoeffs goldbachPositiveScalarHCoeffs := by decide +kernel
  have h := S3Polynomial.eval_hasDerivAt goldbachPositiveScalarACoeffs z
  rw [hc, S3Polynomial.eval_mul] at h
  exact h

