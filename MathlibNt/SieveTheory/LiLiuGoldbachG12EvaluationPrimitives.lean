def lowF (x : ℝ) : ℝ := (33/4 : ℝ)*(lowH x + (52475811071686983675002338241757386038151187590543744374882067 / 84188601614115753557463731805432053903610136946430488653951800 : ℝ)*Real.log (x+29/33))
