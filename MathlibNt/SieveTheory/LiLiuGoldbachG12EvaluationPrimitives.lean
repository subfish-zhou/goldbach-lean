theorem low_division (x : ℝ) (hx : x+29/33 ≠ 0) :
    ((1+x)*S3Correction.L x-x)/(x+29/33) = lowQ x + (52475811071686983675002338241757386038151187590543744374882067 / 84188601614115753557463731805432053903610136946430488653951800 : ℝ)/(x+29/33) := by
  apply (div_eq_iff hx).2
  conv_rhs => rw [add_mul, div_mul_cancel₀ _ hx]
  unfold lowQ S3Correction.L
  ring

theorem lowF_deriv (x : ℝ) (hx : 0 ≤ x) :
    HasDerivAt lowF ((33/4 : ℝ)*((1+x)*S3Correction.L x-x)/(x+29/33)) x := by
