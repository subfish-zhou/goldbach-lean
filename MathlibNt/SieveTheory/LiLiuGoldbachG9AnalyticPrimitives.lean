      primitive1 b - primitive1 a := by
  apply intervalIntegral.integral_eq_sub_of_hasDerivAt
  · intro u hu
    rw [uIcc_of_le hab] at hu
    exact primitive1_deriv u (by linarith [hu.1]) (by linarith [hu.2])
  · apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le hab]
    exact (continuousOn_envelope_kernel 1).mono (Icc_subset_Icc ha hb)

