+/-- Restricting a strict prime cutoff twice retains the smaller cutoff. -/
+private theorem siftingPrimes_filter_real (k : ℕ) {x z : ℝ} (hxz : x ≤ z) :
+    (siftingPrimes k z).filter (fun p : ℕ => (p : ℝ) < x) = siftingPrimes k x := by
+  ext p
+  simp only [Finset.mem_filter, mem_siftingPrimes]
+  exact ⟨fun ⟨⟨hp, _, hk⟩, hx⟩ => ⟨hp, hx, hk⟩,
+    fun ⟨hp, hx, hk⟩ => ⟨⟨hp, hx.trans_le hxz, hk⟩, hx⟩⟩
+
+private theorem siftingPrimes_filter_nat (k : ℕ) {p : ℕ} {z : ℝ}
+    (hpz : (p : ℝ) ≤ z) :
+    (siftingPrimes k z).filter (fun q => q < p) = siftingPrimes k p := by
+  simpa only [Nat.cast_lt] using siftingPrimes_filter_real k hpz
 
