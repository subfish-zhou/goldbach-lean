theorem base_00 :
    deficit (baseCoeffs (left 0) row00) (1 / 20) ≤
        baseCoeffs (left 0) row00 0 ∧ 0 ≤ row00 6 := by
  dsimp [deficit, baseCoeffs, left, row00]
  norm_num

