open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let mut todo := [`WuPaper.R2GammaHigh.actual_count_partial_original]
  let mut seen : Std.HashSet Name := {}
  while !todo.isEmpty do
    let n := todo.head!
    todo := todo.tail!
    if seen.contains n then continue
    seen := seen.insert n
    if let some ci := env.find? n then
      todo := ci.type.getUsedConstants.toList ++ todo
      if let some v := ci.value? (allowOpaque := true) then
        todo := v.getUsedConstants.toList ++ todo
  for n in [`WuPaper.R2GammaHigh.gamma_one_upper,
      `WuPaper.R2GammaHigh.three_negative_lower,
      `WuPaper.R2GammaHigh.gamma_pairs_upper,
      `WuPaper.R2GammaHigh.theta_original_error,
      `WuPaper.R2GammaHigh.classical_coefficient_original,
      `WuPaper.R2GammaHigh.unpaidThirteen,
      `WuSource.SrcSingle.coupled_high_actual_finite] do
    unless seen.contains n do throwError "Missing actual partial edge {n}"
    logInfo m!"PARENT_REACHED {n}"
  for n in [`sorryAx, `Lean.ofReduceBool, `Lean.trustCompiler] do
    if seen.contains n then throwError "Unadmitted trust {n}"
  logInfo "PARENT_PARTIAL_GAMMA_CONSUMER_PASS"
