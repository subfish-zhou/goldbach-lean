    largeLower 0 ≤ largeLo (midpoint cut beta 0) ∧
      largeHi (midpoint cut beta 0) ≤ largeUpper 0 := by
  norm_num [largeLower,largeUpper,largeLo,largeHi,
    largeQLo,largeQHi,smallWLo,smallWHi,logHi,logLo,
    midpoint,point,Finset.sum_range_succ,cut,alpha,beta,lam,
    truncatedSixthLowerAlpha,truncatedSixthLowerBeta,truncatedSixthLowerLambda]

