import CoupledCMCellArithmetic
namespace CoupledCMArithmetic
open Real Wu2008DoubleSieve NodeExtension ActualNineFeedback FirstFeedbackIntegrals
open OriginalSigmaStrength OriginalSigmaCubicRestoration Wu04WholeCollection Wu04FactorEnvelopes
open SharpLogRecurrence JointLogTotalComparison
noncomputable section
theorem retainedNumerator_value : RetainedCommonProfile.paidNumerator NineFeedbackStrength.originalH=( : ℝ) := by
  simp only [RetainedCommonProfile.paidNumerator,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  change NineFeedbackStrength.originalH 0*retainedCellPaid (upperLeft 0) (upperNode 0)+(NineFeedbackStrength.originalH 1*retainedCellPaid (upperLeft 1) (upperNode 1)+(NineFeedbackStrength.originalH 2*retainedCellPaid (upperLeft 2) (upperNode 2)+(NineFeedbackStrength.originalH 3*retainedCellPaid (upperLeft 3) (upperNode 3)+(NineFeedbackStrength.originalH 4*retainedCellPaid (upperLeft 4) (upperNode 4)+(NineFeedbackStrength.originalH 5*retainedCellPaid (upperLeft 5) (upperNode 5)+(NineFeedbackStrength.originalH 6*retainedCellPaid (upperLeft 6) (upperNode 6)+(NineFeedbackStrength.originalH 7*retainedCellPaid (upperLeft 7) (upperNode 7)+(NineFeedbackStrength.originalH 8*retainedCellPaid (upperLeft 8) (upperNode 8)))))))))=( : ℝ)
  dsimp [NineFeedbackStrength.originalH]
  norm_num [retained_cell_0,retained_cell_1,retained_cell_2,retained_cell_3,retained_cell_4,retained_cell_5,retained_cell_6,retained_cell_7,retained_cell_8]
theorem cubicNumerator_value : CubicCommonProfile.cubicPaidNumerator NineFeedbackStrength.originalH=( : ℝ) := by
  simp only [CubicCommonProfile.cubicPaidNumerator,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  change NineFeedbackStrength.originalH 0*cubicCellPaid (upperLeft 0) (upperNode 0)+(NineFeedbackStrength.originalH 1*cubicCellPaid (upperLeft 1) (upperNode 1)+(NineFeedbackStrength.originalH 2*cubicCellPaid (upperLeft 2) (upperNode 2)+(NineFeedbackStrength.originalH 3*cubicCellPaid (upperLeft 3) (upperNode 3)+(NineFeedbackStrength.originalH 4*cubicCellPaid (upperLeft 4) (upperNode 4)+(NineFeedbackStrength.originalH 5*cubicCellPaid (upperLeft 5) (upperNode 5)+(NineFeedbackStrength.originalH 6*cubicCellPaid (upperLeft 6) (upperNode 6)+(NineFeedbackStrength.originalH 7*cubicCellPaid (upperLeft 7) (upperNode 7)+(NineFeedbackStrength.originalH 8*cubicCellPaid (upperLeft 8) (upperNode 8)))))))))=( : ℝ)
  dsimp [NineFeedbackStrength.originalH]
  norm_num [cubic_cell_0,cubic_cell_1,cubic_cell_2,cubic_cell_3,cubic_cell_4,cubic_cell_5,cubic_cell_6,cubic_cell_7,cubic_cell_8]
theorem profile_value : CubicCommonProfile.finiteLower NineFeedbackStrength.originalH=( : ℝ) := by
  unfold CubicCommonProfile.finiteLower CubicCommonProfile.fullNumerator
  rw [retainedNumerator_value,cubicNumerator_value]
  norm_num [CubicCommonProfile.fullD0,retainedPaid,cubicPaid,ca,cb,cc,cd,lowerLog,upperLog,V]
end
end CoupledCMArithmetic
