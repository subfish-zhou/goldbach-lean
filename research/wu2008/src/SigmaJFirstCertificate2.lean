noncomputable section
theorem corrected_2 : correctedCells NineFeedbackStrength.originalH (167/50 : ℝ)=( : ℝ) := by
  simp only [correctedCells,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [correctedCell,cellLeft,upperLeft,upperNode,
    ea,eb,ec,ed,qa,qb,qc,qd,qe,signedLow,low,up,Wu04FactorEnvelopes.lower,upper,leftFactor,rightFactor,lowerLog,upperLog,V]

theorem first_lower_2 : firstLower (firstNode (2 : Fin 5)) (firstS (2 : Fin 5))=( : ℝ) := by
  have he : firstLower (firstNode (2 : Fin 5)) (firstS (2 : Fin 5))=
      firstACoefficient (firstNode 2) (firstS 2)*SigmaExistingLogError.finiteLower NineFeedbackStrength.originalH+
      correctedCells NineFeedbackStrength.originalH (firstS 2)+
      (tailCells NineFeedbackStrength.originalH (firstS 2-2)*jWeight (firstNode 2) (firstS 2)+
        NineFeedbackStrength.originalH 0*jCurvePaid (firstNode 2) (firstS 2))/2 := by
    unfold firstLower firstResidual eRecovery
    ring
  rw [he,SigmaJScalar.profile_value]
  dsimp [firstNode,firstS]
  rw [show (334:ℝ)/100=167/50 by norm_num]
  rw [corrected_2]
  simp only [tailCells,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [firstACoefficient,jWeight,jCurvePaid,cellLeft,upperLeft,upperNode,
    NineFeedbackStrength.originalH,c0,c1,h2,h3,cubic,signedLow,low,up,Wu04FactorEnvelopes.lower,upper,
    leftFactor,rightFactor,lowerLog,upperLog,V]

theorem original_hf_2 : NineFeedbackStrength.originalH (Fin.natAdd 4 (2 : Fin 5)) ≤
    Wu04FirstCore.publication 2+firstFeedback NineFeedbackStrength.originalH (firstNode 2) (firstS 2) := by
  have h := original_firstLower_le (2 : Fin 5)
  rw [first_lower_2] at h
  have hpaid : NineFeedbackStrength.originalH (Fin.natAdd 4 (2 : Fin 5)) ≤
      Wu04FirstCore.publication 2+( : ℝ) := by
    dsimp [NineFeedbackStrength.originalH,Wu04FirstCore.publication,Fin.natAdd]
    norm_num
  linarith only [h,hpaid]
end
end SigmaJFirstCertificates
