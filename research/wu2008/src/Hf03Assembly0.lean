open Real RemainingHf Wu2008DoubleSieve NodeExtension ActualNineFeedback FirstFeedbackIntegrals
open FiniteEndpointPayment CoupledIntegralRecovery
noncomputable section
theorem e0_total : RemainingHf.paidCells NineFeedbackStrength.originalH (firstS 0) = ( : ℝ) := by
  simp only [RemainingHf.paidCells,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [e0_0,e0_1,e0_2,e0_3,e0_4,e0_5,e0_6,e0_7,e0_8]

theorem t0_total : RemainingHf.tailPaid NineFeedbackStrength.originalH (firstS 0-2) = ( : ℝ) := by
  simp only [RemainingHf.tailPaid,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [t0_0,t0_1,t0_2,t0_3,t0_4,t0_5,t0_6,t0_7,t0_8]

theorem j0_total : RemainingHf.jCellsPaid NineFeedbackStrength.originalH (firstNode 0) (firstS 0) = ( : ℝ) := by
  simp only [RemainingHf.jCellsPaid,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [j0_active,j0_empty_1,j0_empty_2,j0_empty_3,j0_empty_4,j0_empty_5,j0_empty_6,j0_empty_7,j0_empty_8]

theorem finite_0_value : RemainingHf.finite (firstNode 0) (firstS 0) = ( : ℝ) := by
  unfold RemainingHf.finite
  rw [SigmaJScalar.profile_value,e0_total,t0_total,j0_total,l0_0,l0_1]
  norm_num

theorem sufficient_0 : NineFeedbackStrength.originalH (Fin.natAdd 4 (0 : Fin 5)) ≤
    Wu04FirstCore.publication 0+RemainingHf.finite (firstNode 0) (firstS 0) := by
  rw [finite_0_value]
  dsimp [NineFeedbackStrength.originalH,Fin.natAdd,Wu04FirstCore.publication]
  norm_num

theorem original_hf_0 : NineFeedbackStrength.originalH (Fin.natAdd 4 (0 : Fin 5)) ≤
    Wu04FirstCore.publication 0+firstFeedback NineFeedbackStrength.originalH (firstNode 0) (firstS 0) := by
  exact sufficient_0 |>.trans (add_le_add le_rfl (RemainingHf.finite_original_rows 0))
end
end Hf03Scalar
