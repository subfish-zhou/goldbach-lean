theorem finite_3_value : RemainingHf.finite (firstNode 3) (firstS 3) = ( : ℝ) := by
  unfold RemainingHf.finite
  rw [SigmaJScalar.profile_value,e3_total,t3_total,j3_total,l3_0,l3_1]
