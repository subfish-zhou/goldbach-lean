theorem j3_total : RemainingHf.jCellsPaid NineFeedbackStrength.originalH (firstNode 3) (firstS 3) = (5093242422183612680937032626922739327828862709367789195622682176231396981190746455500167207523848190081943861987666920796909855461496330213655277/37330676497473699946889089423364361371063483843840894507531600150461967577876694608146645586886027168240950507997995885589121459354058313800000000000 : ℝ) := by
