theorem sufficient_3 : NineFeedbackStrength.originalH (Fin.natAdd 4 (3 : Fin 5)) ≤
    Wu04FirstCore.publication 3+RemainingHf.finite (firstNode 3) (firstS 3) := by
  rw [finite_3_value]
  dsimp [NineFeedbackStrength.originalH,Fin.natAdd,Wu04FirstCore.publication]
  norm_num

theorem original_hf_3 : NineFeedbackStrength.originalH (Fin.natAdd 4 (3 : Fin 5)) ≤
    Wu04FirstCore.publication 3+firstFeedback NineFeedbackStrength.originalH (firstNode 3) (firstS 3) := by
  exact sufficient_3 |>.trans (add_le_add le_rfl (RemainingHf.finite_original_rows 3))
