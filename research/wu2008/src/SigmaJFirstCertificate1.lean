import SigmaJScalarProfile
namespace SigmaJFirstCertificates
open Real Wu2008DoubleSieve NodeExtension ActualNineFeedback FirstFeedbackIntegrals
open FirstErrorFullPayment SigmaExistingLogError Wu04WholeCollection Wu04FactorEnvelopes
open SharpLogRecurrence JointLogTotalComparison Wu04FactorJPrimitive
noncomputable section
theorem corrected_1 : correctedCells NineFeedbackStrength.originalH (347/100 : ℝ)=( : ℝ) := by
  simp only [correctedCells,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [correctedCell,cellLeft,upperLeft,upperNode,
    ea,eb,ec,ed,qa,qb,qc,qd,qe,signedLow,low,up,Wu04FactorEnvelopes.lower,upper,leftFactor,rightFactor,lowerLog,upperLog,V]

theorem first_lower_1 : firstLower (firstNode (1 : Fin 5)) (firstS (1 : Fin 5))=( : ℝ) := by
  have he : firstLower (firstNode (1 : Fin 5)) (firstS (1 : Fin 5))=
      firstACoefficient (firstNode 1) (firstS 1)*SigmaExistingLogError.finiteLower NineFeedbackStrength.originalH+
      correctedCells NineFeedbackStrength.originalH (firstS 1)+
      (tailCells NineFeedbackStrength.originalH (firstS 1-2)*jWeight (firstNode 1) (firstS 1)+
        NineFeedbackStrength.originalH 0*jCurvePaid (firstNode 1) (firstS 1))/2 := by
    unfold firstLower firstResidual eRecovery
    ring
  rw [he,SigmaJScalar.profile_value]
  dsimp [firstNode,firstS]
  rw [corrected_1]
  simp only [tailCells,Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero]
  dsimp [NineFeedbackStrength.originalH]
  norm_num [firstACoefficient,jWeight,jCurvePaid,cellLeft,upperLeft,upperNode,
    NineFeedbackStrength.originalH,c0,c1,h2,h3,cubic,signedLow,low,up,Wu04FactorEnvelopes.lower,upper,
    leftFactor,rightFactor,lowerLog,upperLog,V]

theorem original_hf_1 : NineFeedbackStrength.originalH (Fin.natAdd 4 (1 : Fin 5)) ≤
    Wu04FirstCore.publication 1+firstFeedback NineFeedbackStrength.originalH (firstNode 1) (firstS 1) := by
  have h := original_firstLower_le (1 : Fin 5)
  rw [first_lower_1] at h
  have hpaid : NineFeedbackStrength.originalH (Fin.natAdd 4 (1 : Fin 5)) ≤
      Wu04FirstCore.publication 1+( : ℝ) := by
    dsimp [NineFeedbackStrength.originalH,Wu04FirstCore.publication,Fin.natAdd]
    norm_num
  linarith only [h,hpaid]
end
end SigmaJFirstCertificates
