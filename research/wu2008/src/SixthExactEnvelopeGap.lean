theorem payment_saving_exact : SixthReciprocalTightPayment.payment-payment =  := by
  rw [SixthReciprocalTightPayment.payment_rational,payment_rational]
  norm_num

theorem payment_bounds : (47052/1000000:ℝ) < payment ∧ payment < 47053/1000000 := by
  rw [payment_rational]
  norm_num

theorem saving_bounds : (7433/1000000:ℝ) < SixthReciprocalTightPayment.payment-payment ∧ SixthReciprocalTightPayment.payment-payment < 7434/1000000 := by
  rw [payment_saving_exact]
  norm_num

theorem quarter_saving_bounds : (1858/1000000:ℝ) < (SixthReciprocalTightPayment.payment-payment)/4 ∧ (SixthReciprocalTightPayment.payment-payment)/4 < 1859/1000000 := by
  rw [payment_saving_exact]
  norm_num

