theorem inner_ftc (x : ℝ) : (∫ y in b..(lam-x), first x y) = innerMass x := by
  have hc : Continuous (first x) := by unfold first envelope X Y Z correctedChord chord; fun_prop
  have hd (y : ℝ) : HasDerivAt (fun y => -X x*innerPrimitive x (lam-x-y)) (first x y) y := by
    have hh := ((inner_deriv x (lam-x-y)).comp y
      ((hasDerivAt_const y (lam-x)).sub (hasDerivAt_id y))).const_mul (-X x)
    convert hh using 1 <;> first | rfl | (exact_num; ring)
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun y _ => hd y) (hc.intervalIntegrable b (lam-x))]
  unfold innerMass
  have hz : innerPrimitive x 0 = 0 := by norm_num [innerPrimitive]
  rw [show lam-x-(lam-x)=0 by ring,hz]
  rw [show lam-x-b=lam-b-x by ring]
  ring

