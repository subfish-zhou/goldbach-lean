/-- The original rational V−L identity; no additional logarithm term. -/
theorem gap_exact {t : ℝ} (ht : 1 ≤ t) :
    log t-lowerLog t ≤ (t-1)^5/(10*t*(t+1)^3) := by
  have he : (3/5)*(upperLog t-lowerLog t) = (t-1)^5/(10*t*(t+1)^3) := by
    unfold upperLog lowerLog
    field_simp
    ring
  have hv := log_le_V ht
  unfold V at hv
  linarith only [hv,he]

/-- Exact reciprocal secant remainder, retaining its negative correction.
This is polynomial division of a rational function, not a logarithm expansion. -/
def correctedChord (l u t : ℝ) : ℝ := chord l u t-(t-l)*(u-t)/(l*u^2)

theorem reciprocal_corrected {l u t : ℝ} (hl : 0 < l) (ht : l ≤ t) (hu : t ≤ u) :
    1/t ≤ correctedChord l u t := by
  have ht0 : 0 < t := hl.trans_le ht
  have hu0 : 0 < u := ht0.trans_le hu
  have he : correctedChord l u t-1/t = (t-l)*(u-t)^2/(l*u^2*t) := by
    unfold correctedChord chord
    field_simp
    ring
  have hp : 0 ≤ (t-l)*(u-t)^2/(l*u^2*t) := by positivity
  linarith only [he,hp]

def X (x : ℝ) : ℝ := correctedChord a b x
def Y (y : ℝ) : ℝ := correctedChord b (lam-a) y
def Z (z : ℝ) : ℝ := correctedChord (2*a) (1/2-a-b) z
def C (c : ℝ) : ℝ := correctedChord (1/2-b) (1/2-a) c

def envelope (u t : ℝ) : ℝ := (t-1)^5/10*correctedChord 1 u t*(correctedChord 2 (u+1) (t+1))^3

theorem gap_envelope {u t : ℝ} (ht : 1 ≤ t) (hu : t ≤ u) :
    log t-lowerLog t ≤ envelope u t := by
  have ht0 : 0 < t := by linarith
  have ht1 : 0 < t+1 := by linarith
  have hA := reciprocal_corrected (by norm_num : (0:ℝ)<1) ht hu
  have hB := reciprocal_corrected (by norm_num : (0:ℝ)<2)
    (show 2 ≤ t+1 by linarith) (show t+1 ≤ u+1 by linarith)
  have hA0 : 0 ≤ correctedChord 1 u t := (by positivity : 0 ≤ 1/t).trans hA
  have hB3 := pow_le_pow_left₀ (by positivity : 0 ≤ 1/(t+1)) hB 3
  have hm := mul_le_mul hA hB3 (by positivity) hA0
  have hn : 0 ≤ (t-1)^5/10 := by positivity
  have hp := mul_le_mul_of_nonneg_left hm hn
  have he : (t-1)^5/(10*t*(t+1)^3) = (t-1)^5/10*((1/t)*(1/(t+1))^3) := by
    field_simp
  exact (gap_exact ht).trans (by rw [he]; simpa only [envelope, mul_assoc] using hp)

def first (x y : ℝ) : ℝ :=
  envelope ((1/2-a-b)/a-1) ((1/2-x-y)/a-1)*X x*Y y*Z (1/2-x-y)
def second (x : ℝ) : ℝ :=
  (envelope ((1/2-a-b)/(2*a)) ((1/2-x-b)/(2*a))+
   envelope ((1/2-3*a)/b) ((1/2-x-2*a)/b))*
  ((2/3)*(1/2-x-2*a)*((1/2-x-2*a)^2+3*(1/2-x)^2))*C (1/2-x)^4*X x

theorem first_pointwise {x y : ℝ} (hx : x ∈ Icc a b) (hy : y ∈ Icc b (lam-x)) :
    sixthLogRegular x y ≤ Phase25.exactKernel x y+first x y := by
  have hg := Phase25.mask_geometry hx hy
  have hx0 := hg.1
  have hy0 := hg.2.1
  have hz0 := hg.2.2.2.1
  have ha := geometry.1
  have hb := geometry.2.2.1
  have ht : 1 ≤ (1/2-x-y)/a-1 := by
    have hh : 2*a ≤ 1/2-x-y := hg.2.2.2.2
    have hd := (le_div_iff₀ ha).2 hh
    linarith only [hd]
  have hu : (1/2-x-y)/a-1 ≤ (1/2-a-b)/a-1 := by
    have hh := div_le_div_of_nonneg_right (show 1/2-x-y ≤ 1/2-a-b by linarith [hx.1,hy.1]) ha.le
    linarith only [hh]
  have hgap := gap_envelope ht hu
  have he : Phase25.exactKernel x y = lowerLog (truncatedSixthLowerS 0 x y-1)/(x*y*(1/2-x-y)) := by
    have hz' : 1-x*2-y*2 ≠ 0 := by linarith [hg.2.2.2.1]
    simp only [Phase25.exactKernel,lowerLog,truncatedSixthLowerS,truncatedSixthLowerC,lam,sub_zero]
    field_simp [ha.ne',hg.1.ne',hg.2.1.ne',hg.2.2.2.1.ne',hz']
    ring
  have hX : 1/x ≤ X x := reciprocal_corrected ha hx.1 hx.2
  have hY : 1/y ≤ Y y := reciprocal_corrected hb hy.1 (by linarith [hy.2,hx.1])
  have hZ : 1/(1/2-x-y) ≤ Z (1/2-x-y) := reciprocal_corrected
    (by positivity) hg.2.2.2.2 (by linarith [hx.1,hy.1])
  have hX0 : 0 ≤ X x := (by positivity : 0 ≤ 1/x).trans hX
  have hY0 : 0 ≤ Y y := (by positivity : 0 ≤ 1/y).trans hY
  have hm := mul_le_mul (mul_le_mul hX hY (by positivity) hX0) hZ (by positivity)
    (mul_nonneg hX0 hY0)
  have hn : 0 ≤ envelope ((1/2-a-b)/a-1) ((1/2-x-y)/a-1) :=
    (sub_nonneg.mpr (log_lower ht)).trans hgap
  have hm' := mul_le_mul_of_nonneg_left hm hn
  have hi := div_le_div_of_nonneg_right hgap (mul_pos (mul_pos hg.1 hg.2.1) hg.2.2.2.1).le
  have hid (v : ℝ) : v/(x*y*(1/2-x-y)) = v*((1/x)*(1/y)*(1/(1/2-x-y))) := by
    simp only [div_eq_mul_inv,mul_inv_rev]
    ring
  rw [sub_div] at hi
  rw [hid (envelope ((1/2-a-b)/a-1) ((1/2-x-y)/a-1))] at hi
  have htshape : truncatedSixthLowerS 0 x y-1 = (1/2-x-y)/a-1 := by
    simp only [truncatedSixthLowerS,truncatedSixthLowerC,sub_zero]
  rw [sixth_log_retained hx hy,he]
  rw [htshape]
  unfold first
  nlinarith only [hi,hm']

/-- Keep the endpoint cancellation abstract, without expanding its polynomial factors. -/
private theorem endpoint_payment_algebra {s0 r0 t l1 l2 q1 q2 k n c w : ℝ}
    (h : s0/t*((l1-q1)+(l2-q2)) ≤ n*c*w*k) :
    (s0*(l1+l2)+r0)/t ≤ (s0*(q1+q2)+r0)/t+k*n*c*w := by
  have he : (s0*(l1+l2)+r0)/t =
      (s0*(q1+q2)+r0)/t+s0/t*((l1-q1)+(l2-q2)) := by ring
  rw [he]
  calc
    _ ≤ (s0*(q1+q2)+r0)/t+n*c*w*k := _root_.add_le_add le_rfl h
    _ = _ := by ring

theorem second_pointwise {x : ℝ} (hx : x ∈ Icc a b) :
    Phase25.movingExact x ≤ Phase25.rationalInner (1/2-x)+second x := by
  have hg := Phase25.outer_geometry hx
  have hx0 := hg.1
  have hcpos := hg.2.1
  have hcapos := hg.2.2.2.1
  have ha := geometry.1
  have hb := geometry.2.2.1
  have h1 : 1 ≤ (1/2-x-b)/(2*a) := (le_div_iff₀ (by positivity)).2 (by linarith [hg.2.2.2.2])
  have h2 : 1 ≤ (1/2-x-2*a)/b := (le_div_iff₀ hb).2 (by linarith [hg.2.2.2.2])
  have he1 := gap_envelope h1 (show (1/2-x-b)/(2*a) ≤ (1/2-a-b)/(2*a) from
    div_le_div_of_nonneg_right (by linarith [hx.1]) (by positivity))
  have he2 := gap_envelope h2 (show (1/2-x-2*a)/b ≤ (1/2-3*a)/b from
    div_le_div_of_nonneg_right (by linarith [hx.1]) hb.le)
  have herr := _root_.add_le_add he1 he2
  have hs := Phase25.S_pos (h := 2*a) hg.2.1 (by linarith [hg.2.2.2.1])
  have hX : 1/x ≤ X x := reciprocal_corrected ha hx.1 hx.2
  have hc0 : 0 < 1/2-b := by norm_num [b,truncatedSixthLowerBeta]
  have hC : 1/(1/2-x) ≤ C (1/2-x) := reciprocal_corrected hc0
    (by linarith [hx.2]) (by linarith [hx.1])
  have hC0 : 0 ≤ C (1/2-x) := (by positivity : 0 ≤ 1/(1/2-x)).trans hC
  have hC4 := pow_le_pow_left₀ (by positivity : 0 ≤ 1/(1/2-x)) hC 4
  have hX0 : 0 ≤ X x := (by positivity : 0 ≤ 1/x).trans hX
  have hN : 0 ≤ (2/3:ℝ)*(1/2-x-2*a)*((1/2-x-2*a)^2+3*(1/2-x)^2) := by positivity
  have hp := mul_le_mul (mul_le_mul_of_nonneg_left hC4 hN) hX (by positivity)
    (mul_nonneg hN (pow_nonneg hC0 4))
  have hcoef : Phase25.S (1/2-x) (2*a)/x ≤
      ((2/3)*(1/2-x-2*a)*((1/2-x-2*a)^2+3*(1/2-x)^2))*C (1/2-x)^4*X x := by
    rw [Phase25.S_factor hg.2.1.ne']
    convert hp using 1 <;> first | rfl | field_simp
  have hcoef0 := (div_nonneg hs.le hg.1.le).trans hcoef
  have herr0 : 0 ≤ (log ((1/2-x-b)/(2*a))-lowerLog ((1/2-x-b)/(2*a)))+
      (log ((1/2-x-2*a)/b)-lowerLog ((1/2-x-2*a)/b)) :=
    add_nonneg (sub_nonneg.mpr (log_lower h1)) (sub_nonneg.mpr (log_lower h2))
  have hp' := mul_le_mul hcoef herr herr0 hcoef0
  rw [Phase25.movingExact_endpoint,Phase25.endpoint_difference hg.2.2.1 hg.2.2.2.1]
  unfold Phase25.rationalInner second
  rw [show (1/2:ℝ)-(1/2-x)=x by ring]
  exact endpoint_payment_algebra hp'

