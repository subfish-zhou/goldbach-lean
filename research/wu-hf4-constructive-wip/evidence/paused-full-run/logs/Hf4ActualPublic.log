def NineFeedbackStrength.originalH : Fin 9 → ℝ :=
![223939e-7, 217196e-7, 202876e-7, 181433e-7, 158644e-7, 129923e-7, 100686e-7, 78162e-7, 72943e-7]
def NodeExtension.nineProfile : (Fin 9 → ℝ) → ℝ → ℝ :=
fun z t => ∑ i, (Set.Ioc (NodeExtension.upperLeft i) (NodeExtension.upperNode i)).indicator (fun x => z i) t
def ActualNineFeedback.firstFeedback : (Fin 9 → ℝ) → ℝ → ℝ → ℝ :=
fun z s S => NodeExtension.eProfile (NodeExtension.nineProfile z) S + ActualNineFeedback.profileJ z s S / 2
