def WuTarget.W17Joint.jointMatrix : Fin 9 → Fin 9 → ℝ :=
fun i k => WuTarget.W17Joint.rationalSigmaMatrix i k + WuTarget.W17Joint.remainderMatrix i k
def WuTarget.W17Joint.remainderMatrix : Fin 9 → Fin 9 → ℝ :=
fun i k =>
  WuTarget.W08.paidMatrix i k + WuTarget.W04.extraMatrix i k + WuTarget.W05.jTable i k + WuTarget.W07.paidMatrix i k
def WuTarget.W09.commonRadius : ℝ :=
min (WuTarget.W09.radius 0)
  (min (WuTarget.W09.radius 1)
    (min (WuTarget.W09.radius 2)
      (min (WuTarget.W09.radius 3)
        (min (WuTarget.W09.radius 4)
          (min (WuTarget.W09.radius 5) (min (WuTarget.W09.radius 6) (WuTarget.W09.radius 7)))))))
