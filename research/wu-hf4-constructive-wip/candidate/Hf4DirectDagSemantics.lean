noncomputable def expected (m h : ℚ) : ℕ → List (ℝ → ℝ)
  | 0 => []
  | n+1 => original m h n :: expected m h n

theorem expected_get (m h : ℚ) (n k : ℕ) (hk : k < n) :
    getFun (expected m h n) k = original m h (n-1-k) := by
  induction n generalizing k with
  | zero => omega
  | succ n ih =>
    cases k with
    | zero => rfl
    | succ k =>
      have hk' : k < n := by omega
      have he : n+1-1-(k+1) = n-1-k := by omega
      simpa only [expected, getFun, List.getElem?_cons_succ, he] using ih k hk'

private theorem scale_functions (m h : ℚ) (n : ℕ) (s : ℚ) (c : ℝ)
    (hc : (s : ℝ) = c) :
    (fun x => (s : ℝ) * original m h n x) =
      (fun x => c * original m h n x) := by
  rw [hc]

theorem plan_length : DirectProgram.plan.length = 371 := by rfl

set_option maxHeartbeats 4000000 in
theorem local_steps (m h : ℚ) (j : Fin 371) :
    nextFun (seedFun m h) m h (DirectProgram.plan[j.val]?.getD Step.variable)
      (expected m h j.val) = original m h j.val := by
  fin_cases j
  all_goals
    conv_lhs =>
      arg 4
      unfold DirectProgram.plan
      reduce
  all_goals
    conv_lhs =>
      simp only [nextFun]
  all_goals
    conv_lhs =>
      simp (disch := decide) only [expected_get]
  all_goals
    first
    | rfl
    | apply scale_functions m h
      (norm_num; rfl)

theorem runFun_append (seed : ℕ → ℝ → ℝ) (m h : ℚ)
    (a b : List Step) (fs : List (ℝ → ℝ)) :
    runFun seed m h (a++b) fs = runFun seed m h b (runFun seed m h a fs) := by
  induction a generalizing fs with
  | nil => rfl
  | cons op tail ih =>
    simpa only [List.cons_append, runFun] using ih (nextFun seed m h op fs::fs)

theorem prefix_semantics (m h : ℚ) (n : ℕ) (hn : n ≤ 371) :
    runFun (seedFun m h) m h (DirectProgram.plan.take n) [] = expected m h n := by
  revert hn
  induction n with
  | zero => intro _; rfl
  | succ n ih =>
    intro hn
    have hn' : n < 371 := by omega
    have hp : n < DirectProgram.plan.length := by simpa only [plan_length] using hn'
    have hl := local_steps m h ⟨n,hn'⟩
    simp only [List.getElem?_eq_getElem hp, Option.getD_some] at hl
    rw [List.take_succ_eq_append_getElem hp, runFun_append, ih (by omega)]
    change nextFun (seedFun m h) m h DirectProgram.plan[n] (expected m h n)::expected m h n =
      original m h n::expected m h n
    rw [hl]

theorem original_f370 (m h : ℚ) :
    getFun (runFun (seedFun m h) m h DirectProgram.plan []) 0 =
      (fun x => f370 ((m:ℝ)+(h:ℝ)*x)) := by
  have hh := prefix_semantics m h 371 (by omega)
  have ht : DirectProgram.plan.take 371 = DirectProgram.plan := by
    rw [← plan_length]
    exact List.take_length
  rw [ht] at hh
  rw [hh]
  rfl

end Hf4Quad.CheckedDag.DirectSemantics
